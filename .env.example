NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- E-Mail-Versand (Bestätigung + Anfragen-Benachrichtigung) über SMTP/Nodemailer ---
# SMTP-Zugangsdaten des sendenden Postfachs.
SMTP_HOST=
# 587 = STARTTLS (empfohlen), 465 = implizites TLS/SSL
SMTP_PORT=587
# true nur bei Port 465, sonst false
SMTP_SECURE=false
SMTP_USER=
# Bei Gmail: App-Passwort (Google-Konto → Sicherheit → App-Passwörter), NICHT das normale Login-Passwort
SMTP_PASS=
# Absenderadresse — muss bei den meisten Anbietern identisch mit SMTP_USER sein.
# Für Zustellbarkeit: eigene Domain statt Freemail, siehe docs/2026-07-26-email-zustellbarkeit.md
EMAIL_FROM=
# Anzeigename des Absenders („Steffen Vorholt Comedy <…>"). Default: Steffen Vorholt Comedy
EMAIL_FROM_NAME=

# Empfänger der Benachrichtigungen werden im Admin-Dashboard gepflegt
# (/admin/einstellungen → Tabelle site_settings, Keys notify_email_*).
# Die folgenden Variablen greifen nur noch als Notfall-Fallback, wenn die DB
# nicht erreichbar ist oder ein Feld leer gespeichert wurde:
EMAIL_SHOWS=Steffen.vorholt.comedyshows@gmail.com
EMAIL_BOOKING=Steffen.vorholt.comedybooking@gmail.com

# Kanonische Site-URL. Achtung: die Apex-Domain leitet per 308 auf www um —
# darum www verwenden, sonst laufen alle Links in Mails über einen Redirect.
NEXT_PUBLIC_SITE_URL=https://www.steffenvorholt.de
# Google Search Console: Verifizierungs-Token (nur der Wert aus dem
# <meta name="google-site-verification" content="…">-Tag). Leer lassen, bis vorhanden.
GOOGLE_SITE_VERIFICATION=
